DB_HOST=localhost
DB_PORT=5432
DB_NAME=routeledger
DB_USER=routeledger_app
DB_PASSWORD=change-me
SECRET_KEY=generate-with-python-secrets-token_urlsafe-48
TOKEN_MINUTES=60
# The public URL of the app, used for CORS and the CSRF Origin check.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Host names the server answers to (comma separated).
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Set to true behind HTTPS so the login cookie and HSTS are secure.
COOKIE_SECURE=false
